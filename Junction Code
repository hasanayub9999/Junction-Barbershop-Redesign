<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Junction Barbershop | Princeton Junction, NJ</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0b0b0b;
            color: #fff;
        }

        /* NAVBAR */

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;

            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 20px 7%;

            background: rgba(10, 10, 10, 0.88);
            backdrop-filter: blur(12px);

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .logo span {
            color: #c8a45d;
        }

        nav ul {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        nav a {
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #c8a45d;
        }

        .nav-button {
            background: #c8a45d;
            color: #111;
            padding: 11px 18px;
            border-radius: 6px;
            font-weight: bold;
        }

        /* HERO */

        .hero {
            min-height: 100vh;

            display: flex;
            align-items: center;

            padding: 120px 7% 80px;

            background:
                linear-gradient(
                    90deg,
                    rgba(0,0,0,0.95) 0%,
                    rgba(0,0,0,0.78) 45%,
                    rgba(0,0,0,0.25) 100%
                ),
                url("https://aceoffadez.com.au/wp-content/uploads/2024/05/DSC00593-min-scaled.jpg");

            background-size: cover;
            background-position: center;
        }

        .hero-content {
            max-width: 650px;
        }

        .tag {
            color: #c8a45d;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        h1 {
            font-size: clamp(48px, 7vw, 88px);
            line-height: 0.95;
            margin-bottom: 25px;
        }

        h1 span {
            color: #c8a45d;
        }

        .hero p {
            color: #d1d1d1;
            font-size: 18px;
            line-height: 1.7;
            max-width: 550px;
            margin-bottom: 35px;
        }

        .buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .button {
            padding: 15px 25px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .primary {
            background: #c8a45d;
            color: #111;
        }

        .primary:hover {
            transform: translateY(-3px);
            background: #e0bd70;
        }

        .secondary {
            border: 1px solid #777;
            color: white;
        }

        .secondary:hover {
            background: white;
            color: black;
        }

        /* SECTIONS */

        section {
            padding: 100px 7%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 55px;
        }

        .section-title small {
            color: #c8a45d;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: bold;
        }

        .section-title h2 {
            font-size: 45px;
            margin-top: 10px;
        }

        /* SERVICES */

        .services {
            background: #111;
        }

        .service-grid {
            max-width: 1100px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .service {
            background: #181818;
            padding: 35px;
            border: 1px solid #282828;
            border-radius: 10px;
            transition: 0.3s;
        }

        .service:hover {
            transform: translateY(-7px);
            border-color: #c8a45d;
        }

        .service-number {
            color: #c8a45d;
            font-size: 13px;
            font-weight: bold;
        }

        .service h3 {
            margin: 15px 0 10px;
            font-size: 22px;
        }

        .service p {
            color: #aaa;
            line-height: 1.6;
        }

        /* GALLERY */

        .gallery {
            max-width: 1200px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .gallery img {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 8px;
            transition: 0.4s;
        }

        .gallery img:hover {
            transform: scale(1.03);
        }

        /* ABOUT */

        .about {
            background: #111;
        }

        .about-container {
            max-width: 1100px;
            margin: auto;

            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .about-image img {
            width: 100%;
            height: 550px;
            object-fit: cover;
            border-radius: 10px;
        }

        .about-text h2 {
            font-size: 45px;
            margin-bottom: 20px;
        }

        .about-text h2 span {
            color: #c8a45d;
        }

        .about-text p {
            color: #aaa;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        /* CTA */

        .cta {
            text-align: center;

            background:
                linear-gradient(rgba(0,0,0,.78), rgba(0,0,0,.9)),
                url("https://goldbarbershop.sk/wp-content/uploads/2025/02/9N7A3673-scaled.jpg");

            background-size: cover;
            background-position: center;
        }

        .cta h2 {
            font-size: 50px;
            margin-bottom: 20px;
        }

        .cta p {
            color: #ccc;
            margin-bottom: 30px;
        }

        /* FOOTER */

        footer {
            background: #070707;
            padding: 50px 7%;

            display: flex;
            justify-content: space-between;
            align-items: center;

            color: #777;
        }

        footer strong {
            color: white;
        }

        /* MOBILE */

        @media (max-width: 800px) {

            nav ul {
                display: none;
            }

            .service-grid,
            .gallery,
            .about-container {
                grid-template-columns: 1fr;
            }

            .gallery img {
                height: 350px;
            }

            .about-image img {
                height: 400px;
            }

            .cta h2 {
                font-size: 38px;
            }

            footer {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->

    <nav>
        <div class="logo">
            JUNCTION <span>BARBERSHOP</span>
        </div>

        <ul>
            <li><a href="#services">Services</a></li>
            <li><a href="#gallery">Gallery</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#location">Location</a></li>
        </ul>

        <a href="#location" class="nav-button">
            Book Now
        </a>
    </nav>


    <!-- HERO -->

    <header class="hero">

        <div class="hero-content">

            <div class="tag">
                Princeton Junction • New Jersey
            </div>

            <h1>
                LOOK SHARP.<br>
                <span>FEEL FRESH.</span>
            </h1>

            <p>
                Classic barbering with a modern touch.
                Walk in looking good. Walk out feeling even better.
            </p>

            <div class="buttons">

                <a href="#location" class="button primary">
                    Book an Appointment
                </a>

                <a href="#gallery" class="button secondary">
                    View Our Work
                </a>

            </div>

        </div>

    </header>


    <!-- SERVICES -->

    <section class="services" id="services">

        <div class="section-title">

            <small>What We Do</small>

            <h2>Our Services</h2>

        </div>

        <div class="service-grid">

            <div class="service">

                <div class="service-number">01</div>

                <h3>Classic Haircut</h3>

                <p>
                    A clean, professional cut tailored to your style.
                </p>

            </div>


            <div class="service">

                <div class="service-number">02</div>

                <h3>Fade</h3>

                <p>
                    Clean fades with smooth transitions and sharp finishing.
                </p>

            </div>


            <div class="service">

                <div class="service-number">03</div>

                <h3>Beard Trim</h3>

                <p>
                    Keep your beard shaped, clean and looking sharp.
                </p>

            </div>


            <div class="service">

                <div class="service-number">04</div>

                <h3>Kids Haircut</h3>

                <p>
                    Fresh, comfortable cuts for younger clients.
                </p>

            </div>


            <div class="service">

                <div class="service-number">05</div>

                <h3>Line Up</h3>

                <p>
                    Sharp edges and clean lines to finish your look.
                </p>

            </div>


            <div class="service">

                <div class="service-number">06</div>

                <h3>Hair & Beard</h3>

                <p>
                    The full grooming experience from hair to beard.
                </p>

            </div>

        </div>

    </section>


    <!-- GALLERY -->

    <section id="gallery">

        <div class="section-title">

            <small>Our Work</small>

            <h2>Fresh Cuts</h2>

        </div>

        <div class="gallery">

            <img
                src="https://eminay.com.au/cdn/shop/files/close-up-of-barber-giving-a-fade_339cfab2-6d04-413f-9223-ada5cbe41cb2.jpg?v=1711894553&width=1946"
                alt="Fade haircut"
            >

            <img
                src="https://goldbarbershop.sk/wp-content/uploads/2025/02/9N7A3673-scaled.jpg"
                alt="Barber giving haircut"
            >

            <img
                src="https://msites.cl/onepage-ultraspeed-html/barbershop/index.html"
                alt="Modern haircut"
                onerror="this.style.display='none'"
            >

        </div>

    </section>


    <!-- ABOUT -->

    <section class="about" id="about">

        <div class="about-container">

            <div class="about-image">

                <img
                    src="https://aceoffadez.com.au/wp-content/uploads/2024/05/DSC00593-min-scaled.jpg"
                    alt="Modern barbershop"
                >

            </div>


            <div class="about-text">

                <h2>
                    More Than<br>
                    <span>Just A Haircut.</span>
                </h2>

                <p>
                    Junction Barbershop is your local destination
                    for clean cuts, sharp fades and professional
                    grooming.
                </p>

                <p>
                    Whether you're looking for a classic style,
                    a modern fade or a fresh beard trim,
                    our goal is simple:
                    make sure you leave looking your best.
                </p>

                <a href="#location" class="button primary">
                    Visit Us
                </a>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>READY FOR A FRESH CUT?</h2>

        <p>
            Your next haircut is just one appointment away.
        </p>

        <a href="#location" class="button primary">
            Book Your Cut
        </a>

    </section>


    <!-- LOCATION -->

    <section id="location">

        <div class="section-title">

            <small>Come Visit</small>

            <h2>Junction Barbershop</h2>

            <p style="color:#aaa; margin-top:15px;">
                Princeton Junction, New Jersey
            </p>

        </div>

        <div style="
            max-width:700px;
            margin:auto;
            text-align:center;
            background:#151515;
            padding:40px;
            border-radius:10px;
        ">

            <p style="
                color:#aaa;
                line-height:1.8;
                margin-bottom:25px;
            ">
                Replace this section with the shop's verified
                address, phone number, hours and booking link.
            </p>

            <a
                href="#"
                class="button primary"
                onclick="alert('Replace this button with Junction Barbershop\\'s real booking link.')"
            >
                Book an Appointment
            </a>

        </div>

    </section>


    <!-- FOOTER -->

    <footer>

        <div>
            <strong>JUNCTION BARBERSHOP</strong>
        </div>

        <div>
            Princeton Junction, NJ
        </div>

    </footer>


    <script>

        // Simple scroll animation

        document.querySelectorAll('a[href^="#"]').forEach(link => {

            link.addEventListener('click', function(e) {

                const target = document.querySelector(
                    this.getAttribute('href')
                );

                if (target) {

                    e.preventDefault();

                    target.scrollIntoView({
                        behavior: 'smooth'
                    });

                }

            });

        });

    </script>

</body>
</html>
